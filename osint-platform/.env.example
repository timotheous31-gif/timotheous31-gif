# ---------------------------------------------------------------------------
# OSINT Investigation Platform — configuration
#
# Copy to `.env` and fill in what you need. Every value has a safe default;
# nothing here is required to run the platform with the key-free collectors
# (DNS, RDAP, certificate transparency, HTTP metadata, Wayback, public GitHub).
#
# NEVER commit a filled-in `.env`.
# ---------------------------------------------------------------------------

# --- general ---------------------------------------------------------------
ENVIRONMENT=development           # development | test | production
DEBUG=false
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                # console | json
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://osint:osint@localhost:5432/osint
DB_ECHO=false
POSTGRES_USER=osint
POSTGRES_PASSWORD=osint
POSTGRES_DB=osint

# --- cache / queue ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Run investigations inline instead of dispatching to a worker (dev/CLI).
CELERY_TASK_ALWAYS_EAGER=false

# --- outbound networking ---------------------------------------------------
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_REDIRECTS=5
HTTP_MAX_RESPONSE_BYTES=5242880
HTTP_MAX_CONCURRENCY=10
HTTP_RETRY_ATTEMPTS=3
HTTP_USER_AGENT=osint-platform/0.1 (+https://github.com/osint-platform; lawful OSINT research)
RESPECT_ROBOTS_TXT=true
COLLECTOR_CONCURRENCY=6
COLLECTOR_TIMEOUT_SECONDS=60

# SSRF guard. Leave false unless you are running an AUTHORISED internal-security
# engagement against your own infrastructure. Cloud metadata endpoints stay
# blocked either way.
ALLOW_PRIVATE_NETWORKS=false

# --- privacy ---------------------------------------------------------------
PRIVACY_REDACTION_ENABLED=true
EVIDENCE_STORE_RAW=true
EVIDENCE_DIR=./data/evidence

# --- free person sources (no key, no account, no cost) ---------------------
# PERSON investigations run entirely on these. Nothing below is a credential;
# they are here only so a deployment can point at a mirror.
ORCID_API_URL=https://pub.orcid.org
OPENALEX_API_URL=https://api.openalex.org
CROSSREF_API_URL=https://api.crossref.org
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
REDDIT_BASE_URL=https://www.reddit.com

# OpenAlex and Crossref offer a faster "polite pool" to callers who identify
# themselves with a contact address. Optional, and not a credential — both APIs
# work without it.
OPENALEX_MAILTO=
CROSSREF_MAILTO=

# PERSON reconnaissance never needs a paid search API. The platform generates
# the queries and you run them in your own browser; see docs/person-recon.md.

# --- external providers (all optional) -------------------------------------
# Search is the only paid source, and nothing depends on it: with
# SEARCH_PROVIDER=none a PERSON investigation still runs every free source
# above and records the search collector as SKIPPED with the reason.
# none | anthropic_web_search | google_wss | brave | bing | serper
SEARCH_PROVIDER=none
BRAVE_API_KEY=
BING_API_KEY=
SERPER_API_KEY=

# --- Anthropic web search (optional secondary channel) ----------------------
# A *secondary* discovery channel, not a replacement for a deterministic search
# API. Anthropic's server-side web search decides its own queries (there is no
# parameter that submits an exact one), returns no page description and no
# documented ranking, and bills per search. The platform therefore records what
# it actually executed, never synthesises a description, and caps spend with
# ANTHROPIC_WEB_SEARCH_MAX_USES.
#
# Read docs/search-provider-compliance.md before enabling this for commercial
# work: whether results may be stored, cached or redistributed in a commercial
# investigation product is NOT established by Anthropic's documentation.
#
# Required only when SEARCH_PROVIDER=anthropic_web_search. Leave blank
# otherwise; nothing reads these keys in any other mode.
ANTHROPIC_API_KEY=
# Anthropic's own web-search documentation uses this model in its examples.
ANTHROPIC_WEB_SEARCH_MODEL=claude-opus-5
# The hard spend cap: searches per request, enforced by Anthropic. An exceeded
# cap returns a tool-result error, and an errored search is not billed.
ANTHROPIC_WEB_SEARCH_MAX_USES=4
ANTHROPIC_WEB_SEARCH_MAX_TOKENS=4096
# Published price per search, used only for the cost *estimate* shown in the
# report. Never presented as a billed total. $10 per 1,000 searches.
ANTHROPIC_WEB_SEARCH_UNIT_COST_USD=0.01
# Domain control. Set one or neither — Anthropic rejects a request carrying both.
# Comma-separated bare domains, no scheme. An organisation-level allow-list set
# in the Claude Console applies on top of this and is outside the platform.
ANTHROPIC_WEB_SEARCH_ALLOWED_DOMAINS=
ANTHROPIC_WEB_SEARCH_BLOCKED_DOMAINS=
# Coarse localisation only, passed through as the documented user_location.
# City / region / ISO 3166-1 alpha-2 country / IANA timezone. Never derived from
# the investigator's address or IP, and never narrower than a city.
ANTHROPIC_WEB_SEARCH_CITY=
ANTHROPIC_WEB_SEARCH_REGION=
ANTHROPIC_WEB_SEARCH_COUNTRY=
ANTHROPIC_WEB_SEARCH_TIMEZONE=

# --- Google Web Search Service (PENDING_PARTNER_ACCESS) ---------------------
# Configuration path only. The provider refuses to issue a request whatever is
# set here, because partner credentials have not been issued and faking access
# would be worse than not having it. See docs/search-provider-compliance.md.
GOOGLE_WSS_API_KEY=
GOOGLE_WSS_CLIENT_ID=
GOOGLE_WSS_ENDPOINT=

# --- search-result enrichment ----------------------------------------------
# Some providers return a URL and a title and no description. Rather than invent
# one, the platform may read a small number of the most promising result pages
# itself, through the same SSRF-guarded client every collector uses, and keep a
# short public text excerpt. Strictly bounded: an uncapped fetch of every search
# result would be a crawler, and this is not one.
RESULT_ENRICHMENT_ENABLED=true
MAX_RESULT_ENRICHMENTS_PER_INVESTIGATION=3
RESULT_ENRICHMENT_MAX_BYTES=750000
RESULT_ENRICHMENT_EXCERPT_CHARS=600

# Public GitHub API. Works unauthenticated at 60 req/h; a fine-grained
# read-only token raises that to 5000 req/h. Never use a token with write or
# private-repository scopes here. Leaving this blank is the same as omitting it:
# the collector runs anonymously rather than sending an empty credential.
GITHUB_TOKEN=

# Have I Been Pwned. Returns breach *names and dates* only — this platform
# never retrieves, stores or displays breached credentials.
HIBP_API_KEY=

# --- service endpoints (override only if you mirror them) ------------------
CRTSH_BASE_URL=https://crt.sh
RDAP_BOOTSTRAP_URL=https://rdap.org
WAYBACK_BASE_URL=https://web.archive.org
GITHUB_API_URL=https://api.github.com

# --- frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
